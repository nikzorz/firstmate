diff --git a/tests/fm-remote-secondmate-lifecycle-e2e.test.sh b/tests/fm-remote-secondmate-lifecycle-e2e.test.sh
index 1e24330..3fd9845 100755
--- a/tests/fm-remote-secondmate-lifecycle-e2e.test.sh
